NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://hygienelinkstrading.com
NEXT_PUBLIC_BASE_PATH=
BASE_PATH=
STAGING_NOINDEX=false

# cPanel MySQL database details (cPanel prefixes both values with your cPanel username)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_dco
DB_USER=cpaneluser_dcouser
DB_PASSWORD=replace-with-a-strong-database-password
DB_CONNECTION_LIMIT=10

# CMS administrator & security
CMS_ADMIN_EMAIL=admin@hygienelinkstrading.com
CMS_ADMIN_PASSWORD_HASH=scrypt$replace-salt$replace-hash
CMS_SESSION_SECRET=replace-with-at-least-64-random-characters

# Use an absolute path in cPanel, outside public_html when possible
UPLOAD_DIR=/home/cpaneluser/dco-storage/uploads

# Enquiry notification email
ENQUIRY_TO_EMAIL=info@diamondcapitaloasis.com
